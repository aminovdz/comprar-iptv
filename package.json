{
  "name": "comprar-iptv",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "mkdir -p dist/server && touch dist/server/entry.mjs && astro build && rm -f node_modules/.bin/astro && printf '#!/bin/sh\\nexit 0\\n' > node_modules/.bin/astro && chmod +x node_modules/.bin/astro",
