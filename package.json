    "astro": "astro",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^7.1.3",
    "lucide-astro": "^0.556.0",
    "tailwindcss": "^4.0.0",
    "wrangler": "^4.114.0"
  }
}
