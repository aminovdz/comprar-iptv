---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;

const brandName = "comprar iptv";
const waNumber = "https://wa.link/9ezhx6";

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": brandName,
  "url": "https://comprariptv.com",
  "logo": "https://comprariptv.com/logo.png",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+34-000-000-000",
    "contactType": "customer service",
    "email": "contact@comprariptv.com"
  }
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		
		<!-- Google Analytics (G-tag) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-XXXXXXXXXX');
		</script>

		<!-- Cloudflare Web Analytics -->
		<script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "YOUR_TOKEN"}'></script>
	</head>
	<body class="bg-dark text-white selection:bg-secondary selection:text-dark">
		<slot />

		<!-- Floating WhatsApp Button -->
		<a 
			href={waNumber} 
			class="fixed bottom-6 right-6 z-[100] bg-[#25D366] text-white p-4 rounded-full shadow-2xl hover:scale-110 transition-transform flex items-center justify-center group"
			aria-label="Contactar por WhatsApp"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="#ffffff" class="group-hover:rotate-12 transition-transform">
				<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
			</svg>
			<span class="absolute right-full mr-4 bg-white text-dark px-3 py-1 rounded-lg text-sm font-bold whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity hidden sm:block">
				¿Necesitas ayuda?
			</span>
		</a>

		<!-- Marketing Popup -->
		<div id="marketing-popup" class="fixed inset-0 z-[200] flex items-center justify-center p-6 bg-dark/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-500">
			<div class="glass-card max-w-md w-full p-8 rounded-3xl relative text-center border-secondary/30 scale-95 transition-transform duration-500">
				<button id="close-popup" class="absolute top-4 right-4 text-slate-500 hover:text-white transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
				</button>
				<div class="w-20 h-20 bg-secondary/20 rounded-full flex items-center justify-center mx-auto mb-6">
					<span class="text-4xl">🎁</span>
				</div>
				<h2 class="text-3xl font-bold mb-4 text-white">¡Únete a la Comunidad!</h2>
				<p class="text-slate-400 mb-8">Síguenos en nuestros canales oficiales para recibir **ofertas flash, actualizaciones de canales** y soporte inmediato.</p>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<a href="https://t.me/castvera_com" class="bg-[#0088cc] text-white py-4 rounded-xl font-bold hover:scale-105 transition-transform flex items-center justify-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
						Telegram
					</a>
					<a href="https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v" class="bg-[#25D366] text-white py-4 rounded-xl font-bold hover:scale-105 transition-transform flex items-center justify-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 1 1-7.6-7.6 8.38 8.38 0 0 1 3.8.9L21 3z"/></svg>
						WhatsApp
					</a>
				</div>
				<button id="close-popup-alt" class="mt-6 text-xs text-slate-500 hover:text-white underline underline-offset-4">
					Cerrar y continuar navegando
				</button>
			</div>
		</div>

		<!-- Exit Intent Popup -->
		<div id="exit-intent-popup" class="fixed inset-0 z-[250] flex items-center justify-center p-6 bg-dark/90 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-500">
			<div class="glass-card max-w-lg w-full p-12 rounded-[40px] relative text-center border-primary/30">
				<button id="close-exit-popup" class="absolute top-6 right-6 text-slate-500 hover:text-white transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
				</button>
				<div class="w-24 h-24 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-8">
					<span class="text-5xl">⚡</span>
				</div>
				<h2 class="text-4xl font-bold mb-6 text-white leading-tight">¡No te vayas sin tu descuento!</h2>
				<p class="text-slate-400 mb-10 text-lg">Usa el cupón <span class="text-primary font-bold">ESPAÑA10</span> para un 10% de descuento adicional en tu suscripción de 12 meses.</p>
				<div class="flex flex-col gap-4">
					<a href="https://wa.link/9ezhx6" class="bg-primary text-white py-5 rounded-2xl font-bold text-xl hover:scale-105 transition-transform shadow-lg shadow-primary/20">
						Canjear en WhatsApp
					</a>
					<button id="close-exit-popup-alt" class="text-sm text-slate-500 hover:text-white underline underline-offset-4">
						Continuar al sitio
					</button>
				</div>
			</div>
		</div>

		<script is:inline>
			// Marketing Popup Logic
			setTimeout(() => {
				const popup = document.getElementById('marketing-popup');
				if (popup && !localStorage.getItem('popupShown')) {
					popup.classList.remove('opacity-0', 'pointer-events-none');
					popup.querySelector('.glass-card').classList.remove('scale-95');
					localStorage.setItem('popupShown', 'true');
				}
			}, 10000);

			// Exit Intent Logic
			let exitPopupShown = false;
			document.addEventListener("mouseleave", (e) => {
				if (e.clientY < 0 && !exitPopupShown) {
					const popup = document.getElementById('exit-intent-popup');
					if (popup) {
						popup.classList.remove('opacity-0', 'pointer-events-none');
						exitPopupShown = true;
					}
				}
			});

			const closePopups = () => {
				document.getElementById('marketing-popup')?.classList.add('opacity-0', 'pointer-events-none');
				document.getElementById('exit-intent-popup')?.classList.add('opacity-0', 'pointer-events-none');
			};

			document.getElementById('close-popup')?.addEventListener('click', closePopups);
			document.getElementById('close-popup-alt')?.addEventListener('click', closePopups);
			document.getElementById('close-exit-popup')?.addEventListener('click', closePopups);
			document.getElementById('close-exit-popup-alt')?.addEventListener('click', closePopups);
		</script>
	</body>
</html>
