---
import Layout from './Layout.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<Layout title={`${title} | Comprar IPTV`} description={`Legal information about ${title} on Comprar IPTV.`}>
	<header class="pt-32 pb-10 text-center px-6">
		<h1 class="text-4xl font-bold mb-4">{title}</h1>
	</header>

	<main class="max-w-3xl mx-auto px-6 pb-24 prose prose-invert">
		<slot />
	</main>
</Layout>
